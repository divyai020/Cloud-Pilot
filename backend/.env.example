# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cloudpilot_db

# Application Settings
DEBUG=True

# CORS Settings (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Settings
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM Service Settings (Phase 11C)
# Options for LLM_PROVIDER: openai, gemini, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=your_llm_api_key_here
LLM_TIMEOUT=10
